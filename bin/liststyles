#!/usr/bin/raku

use lib $*PROGRAM.parent.add('../lib');
use SubtitleParser;

sub MAIN(*@filenames) {
    my @styles = @filenames.map: -> $filename { extract-styles-from($filename) };
    @styles.unique>>.say;
}

sub extract-styles-from(Str $filename) {
    with $filename.IO.slurp() -> $subtitle-content {
        my $subs = SubtitleParser.parse_ssa($subtitle-content);
        my @style-names = $subs.styles.map: -> $style { $style.get('Name') };
        return @style-names.Slip;
    } else {
        die "Cannot parse subtitles from $filename: { .exception.message }";
    }
}
